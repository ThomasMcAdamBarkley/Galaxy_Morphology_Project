# Ignore Data (but keep directory placeholders)
data/*
!data/.gitkeep
!data/images_train/
data/images_train/*
!data/images_train/.gitkeep
*.csv
*.zip

# Ignore Python cache
__pycache__/
*.pyc

# Ignore Virtual Environment (if it's in this folder)
galaxy_env/
.venv/
env/

# Ignore IDE settings
.vscode/
.vs/

# Ignore trained model files (too large for GitHub — store locally)
*.keras
*.h5
# But keep directory placeholders
!src/models/.gitkeep

# Ignore training logs (large/binary)
outputs/*.log